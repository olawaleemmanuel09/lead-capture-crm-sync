        "sendTo": "={{ $('Parse & Clean Lead').item.json.email }}",
        "subject": "We received your request \u2014 talk soon!",
        "emailType": "html",
        "message": "=<p>Hi {{ $('Parse & Clean Lead').item.json.firstName }},</p><p>Thanks for reaching out{{ $('Parse & Clean Lead').item.json.serviceInterest ? ' about <strong>' + $('Parse & Clean Lead').item.json.serviceInterest + '</strong>' : '' }}. Your request has been received and a member of our team will get back to you shortly.</p><p>In the meantime, feel free to reply to this email if you have any additional details to share.</p><p>Best regards,<br>The Team</p>",
        "options": {
          "appendAttribution": false
        }
      },

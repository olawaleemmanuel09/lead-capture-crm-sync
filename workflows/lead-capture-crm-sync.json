      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Tally Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "lead-capture-tally"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Parse Tally webhook payload \u2014 label-based lookup, order-independent\nconst body = $json.body ?? $json;\nconst data = body.data ?? body;\nconst fields = Array.isArray(data.fields) ? data.fields : [];\n\nconst getField = (label) => {\n  const f = fields.find(\n    (x) => x.label && x.label.trim().toLowerCase() === label.toLowerCase()\n  );\n  if (!f || f.value === null || f.value === undefined) return '';\n  // Dropdowns / multiple choice: Tally sends an array of option IDs\n  if (Array.isArray(f.value)) {\n    if (Array.isArray(f.options)) {\n      return f.value\n        .map((id) => {\n          const opt = f.options.find((o) => o.id === id);\n          return opt ? opt.text : id;\n        })\n        .join(', ');\n    }\n    return f.value.join(', ');\n  }\n  return String(f.value).trim();\n};\n\nconst properCase = (s) =>\n  String(s)\n    .toLowerCase()\n    .split(/\\s+/)\n    .filter(Boolean)\n    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))\n    .join(' ');\n\nconst rawName = getField('Full Name');\nconst fullName = rawName ? properCase(rawName) : '';\nconst nameParts = fullName.split(' ');\nconst firstName = nameParts[0] || '';\nconst lastName = nameParts.slice(1).join(' ') || '';\n\nconst email = getField('Email').toLowerCase();\nconst emailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\n\nreturn [\n  {\n    json: {\n      fullName,\n      firstName,\n      lastName,\n      email,\n      emailValid,\n      company: getField('Company') ? properCase(getField('Company')) : '',\n      serviceInterest: getField('Service Interest'),\n      message: getField('Message'),\n      submittedAt: data.createdAt || new Date().toISOString(),\n      source: 'Tally Form'\n    }\n  }\n];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Parse & Clean Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
